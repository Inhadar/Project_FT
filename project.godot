; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="Project_FT"
run/main_scene="res://Worlds/World.tscn"
config/icon="res://icon.png"

[autoload]

Globals="*res://Globals.gd"
SceneChanger="*res://SceneChanger.gd"
PlayerInventory="*res://Inventory_prototype/Data/PlayerInventory.gd"
JsonData="*res://Inventory_prototype/JSONData.gd"
PaternScript="*res://Build_paterns/Patern_Script.gd"

[display]

window/size/test_width=512
window/size/test_height=300
window/vsync/use_vsync=false
window/stretch/mode="2d"
window/stretch/aspect="keep"

[global]

vys=false

[gui]

common/drop_mouse_on_gui_input_disabled=true

